{
  "title": "Scopion (Google Sheets)",
  "rules": [
    {
      "description": "Cmd+Shift+A -> Cmd+Option+Shift+1 (Scopion macro) in browsers only",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "a",
            "modifiers": { "mandatory": ["left_command", "left_shift"] }
          },
          "to": [
            {
              "key_code": "1",
              "modifiers": ["left_command", "left_option", "left_shift"]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.google\\.Chrome$",
                "^com\\.apple\\.Safari$",
                "^org\\.mozilla\\.firefox$",
                "^com\\.microsoft\\.edgemac$"
              ]
            }
          ]
        }
      ]
    }
  ]
}
